{
  "name": "multilingual-analyze",
  "version": "0.1.0",
  "description": "基于 AST 抽取的多语言分析工作台：支持 React/Vue，规则+LLM 分析 common，本地页面确认并翻译",
  "license": "MIT",
  "type": "module",
  "bin": {
    "multilingual-analyze": "./dist/cli.mjs",
    "mla": "./dist/cli.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shzjj82/MultilingualAnalyze.git"
  },
  "bugs": {
    "url": "https://github.com/shzjj82/MultilingualAnalyze/issues"
  },
  "homepage": "https://github.com/shzjj82/MultilingualAnalyze#readme",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai-automate-worker": "./dist/ai-automate-worker.mjs"
  },
  "files": [
    "dist",
    "ui"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:ui",
    "build:cli": "pkgroll --clean-dist",
    "build:ui": "vite build --config web/vite.config.ts",
    "dev": "pkgroll --watch",
    "dev:ui": "vite --config web/vite.config.ts",
    "ui:add": "npx shadcn@latest add",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "validate": "npm run typecheck && npm run build",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "i18n",
    "ast",
    "react",
    "vue",
    "multilingual",
    "extract",
    "llm"
  ],
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@vue/compiler-sfc": "^3.5.18",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "open": "^10.2.0"
  },
  "optionalDependencies": {
    "@ifreeovo/i18n-extract-cli": "^4.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "lucide-react": "^1.35.0",
    "pkgroll": "^2.28.1",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
